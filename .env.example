# ==========================================
# Discord Music Bot Configuration
# ==========================================

# [REQUIRED] Discord Bot Token from Discord Developer Portal
# Bot must have Guilds and Guild Voice States intents enabled.
DISCORD_TOKEN=your_bot_token_here

# [OPTIONAL] Discord Application / Client ID
# If left blank, the bot will auto-detect it from the session.
DISCORD_APP_ID=

# [OPTIONAL] Guild ID for immediate slash command registration during development.
# If empty, commands will be registered globally (may take up to a few minutes on Discord).
DISCORD_GUILD_ID=

# [OPTIONAL] Audio extraction mode: "ytdlp", "hybrid", or "piped"
# - ytdlp: uses local yt-dlp binary with IPv4 egress (FAST & RECOMMENDED)
# - hybrid: uses yt-dlp first, falls back to Piped API if needed
# - piped: queries Piped API only
AUDIO_SOURCE_MODE=ytdlp

# [OPTIONAL] Piped API Instance URL (without trailing slash)
# Check https://github.com/TeamPiped/Documentation/blob/main/content/docs/public-instances/index.md for instances
PIPED_API_URL=https://api.piped.private.coffee

# [OPTIONAL] Default audio volume (1 - 100)
DEFAULT_VOLUME=100

# [OPTIONAL] Auto-disconnect idle duration when queue is finished (e.g. 1m, 3m, 5m)
IDLE_TIMEOUT=3m

# [OPTIONAL] Auto-disconnect duration when voice channel is empty of users (e.g. 30s, 1m, 2m, 0s to disable)
EMPTY_CHANNEL_TIMEOUT=1m

# [OPTIONAL] Autoplay recommended tracks when queue is empty (true or false)
DEFAULT_AUTOPLAY=false

# [OPTIONAL] Log level: "info" or "debug"
LOG_LEVEL=info

# [OPTIONAL] Path to a Netscape-format cookies.txt for yt-dlp.
# Rescue path for YouTube's "Sign in to confirm you're not a bot" wall on some egress IPs.
# Default is guest (no-login) mode: leave empty/commented to keep current behaviour.
# Docker users: the cookies volume in docker-compose.yml is already active — keep it
# WRITABLE (do NOT add ":ro"): yt-dlp dumps its refreshed cookie jar back into the
# file on exit, so a read-only mount crashes every extraction at process exit.
# YTDLP_COOKIES_FILE=

# [OPTIONAL] Browser name for yt-dlp --cookies-from-browser (e.g. chrome, firefox, safari).
# Default is guest mode: leave empty/commented. If YTDLP_COOKIES_FILE is also set, the file wins.
# YTDLP_COOKIES_FROM_BROWSER=

